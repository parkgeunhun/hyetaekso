{
  "name": "hyetaekso",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build && node scripts/prerender.mjs",
    "test": "node --test tests/*.test.js",
    "worker:check": "wrangler deploy --dry-run --config backend/wrangler.jsonc --outdir .worker-build",
    "admin:create": "node --env-file-if-exists=.env scripts/create-admin.mjs",
    "db:apply": "node --env-file-if-exists=.env scripts/apply-schema.mjs",
    "admin:set": "node --env-file-if-exists=.env scripts/create-admin.mjs",
    "db:migrate": "node --env-file-if-exists=.env scripts/apply-schema.mjs",
    "stage:pages": "node scripts/stage-pages.mjs",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "exceljs": "4.4.0",
    "lucide-react": "0.468.0",
    "mysql2": "3.23.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-router-dom": "7.18.2"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@vitejs/plugin-react": "5.1.0",
    "vite": "7.3.7",
    "wrangler": "4.158.0"
  },
  "overrides": {
    "exceljs": {
      "uuid": "11.1.1"
    }
  }
}
